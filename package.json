{
	"name": "@wovel/workspace",
	"license": "MIT OR Apache-2.0",
	"private": true,
	"packageManager": "pnpm@9.15.9",
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter @wovel/example-starter dev",
		"typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit",
		"prepare": "effect-tsgo patch --typescript --no-oxlint",
		"build": "pnpm -r build",
		"test": "pnpm -r test"
	},
	"devDependencies": {
		"@effect/tsgo": "0.48.1",
		"@types/node": "26.6.0",
		"tsdown": "0.23.1",
		"typescript": "7"
	}
}
